DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me
# Laptop test server: leave unset so phones on the same Wi-Fi can connect (any host is accepted when DEBUG is on).
# On a real server list its domain, e.g. DJANGO_ALLOWED_HOSTS=ob.example.com
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://ob_app:ob_app_dev_password@localhost:5432/onlybroker
REDIS_URL=redis://localhost:6379/0
# 32 random bytes, base64: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
OB_FIELD_KEY=
OB_PHONE_PEPPER=
OB_OTP_PROVIDER=console
OB_PUBLIC_BASE_URL=http://localhost:8000
